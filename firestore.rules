rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Admin authorization: there is no custom claim or Firestore role field.
// The app gates admin UI purely on a hardcoded email (app/admin/layout.tsx).
// isAdmin() below mirrors that. The `adminUsers` collection is a separate,
// disconnected staff directory and is NOT the admin gate.
//
// Collection: products            Doc ID: auto-id
//   vendorId(string=uid, immutable), title, thumbnail, images(array<string>),
//   sellingPrice(number), mrp(number), costPrice(number), stock(number),
//   active(bool), approved(bool), categoryId, ... (many descriptive fields)
//   Read: public. Write: owning vendor or admin. Checkout is additionally
//   allowed to decrement `stock` / increment `sales` only (no vendor account
//   is involved in that step).
//
// Collection: orders               Doc ID: auto-id
//   userId(string=uid, immutable), vendorIds(array<string=uid>), items(array),
//   total(number), status(string), paymentStatus(string),
//   deliveryPartnerId(string, references a deliveryPartners doc id — not a
//   uid). Pay on Delivery (UPI Only) orders (paymentMethod ==
//   'PAY_ON_DELIVERY_UPI') additionally carry: paymentAmount(number,
//   server-verified at creation in app/api/create-order, never
//   client-supplied); paymentTransactionId, paymentSubmittedAt,
//   paymentConfirmedBy(uid), paymentConfirmedByName once the assigned
//   delivery partner submits a claim (paymentStatus ->
//   'AwaitingVerification', see isValidDeliveryPaymentSubmission() below);
//   paymentVerifiedAt, paymentVerifiedBy(uid), paymentVerifiedByName once
//   admin independently verifies it (paymentStatus -> 'Paid').
//   Create: the customer, for themselves. Read: owning customer, any vendor
//   listed in vendorIds, or admin. Update: admin (any field, including
//   promoting AwaitingVerification -> Paid), owning customer (cancel only,
//   Pending->Cancelled), listed vendor (status/tracking fields; may also
//   self-mark paymentStatus Paid on Delivered, but only for legacy
//   non-UPI orders — see isValidDeliveryPaymentSubmission() for the UPI
//   path, which never lets a seller or delivery partner reach Paid
//   directly), the assigned delivery partner (status/notes/
//   proof-of-delivery fields, or — as a separate write — the payment-
//   submission fields above; resolved via
//   deliveryPartners/{deliveryPartnerId}.uid).
//
// Collection: vendors               Doc ID: auto-id (NOT the vendor's uid —
//   several app call sites incorrectly assume doc-id==uid; ownership here is
//   always via the `uid` field, never the document id)
//   uid(string, immutable), status(string,"Pending"|"Approved"|"Rejected"),
//   kycStatus(string), plus bank account/PAN/Aadhaar/KYC-doc-URL fields (PII).
//   Create: signed-in user creating their own application, status/kycStatus
//   forced to "Pending". Read/update: owner or admin only — this collection
//   holds banking/KYC PII and must never be broadly readable, even though the
//   public storefront page currently tries to read it (see follow-ups).
//
// Collection: users                 Doc ID: uid
//   uid, name, email, role("customer"), rewardPoints(number), status.
//   Owner CRUD on their own doc, role/status immutable by the owner. A signup
//   referral bonus performs a narrow cross-user write of exactly
//   {rewardPoints, totalReferrals} (increasing only) on the referrer's doc —
//   allowed as a scoped carve-out, nothing else.
//
// Collection: chats                 Doc ID: auto-id
//   sellerId(string=uid, always present). customerId(uid) and/or
//   customerEmail are present depending on which of 3 code paths created the
//   chat. A participant is: sellerId==auth.uid, OR customerId==auth.uid (if
//   present), OR customerEmail==auth.token.email (if present).
//
// Collection: messages              Doc ID: auto-id (top-level, linked to
//   chats only via a `chatId` field — not a subcollection)
//   chatId(string), text/image, createdAt. The live UI never writes a uid on
//   the message itself, so authorization is derived by reading the parent
//   chats/{chatId} document and checking participant membership there.
//
// Collection: notifications         Doc ID: auto-id
//   userId(uid, present for customer/seller docs), role("customer"|"seller"|
//   "admin"), read(bool). These are written as a side effect of many
//   different authenticated flows (checkout, admin actions, chat) on behalf
//   of another user, so create is validated by shape only, not by creator
//   identity. Read/update(mark read) restricted to the named recipient
//   (userId==uid) or admin (for role=="admin" docs).
//
// Collection: addresses, tickets, returns, withdrawals   Doc ID: auto-id
//   Web-app documents in these have no uid field — ownership is by
//   `userEmail` / `vendorEmail` matching request.auth.token.email.
//   addresses and tickets additionally accept the mobile app's own
//   userId-owned documents (screens/AddressScreen.tsx,
//   screens/SupportScreen.tsx write/query by auth.currentUser.uid,
//   not email) — see isValidMobileAddress() and the isOwnerUid()
//   branch on tickets' read rule. Two independent, additive
//   ownership models on the same collection, not a replacement.
//

// Collection: coupons               Doc ID: auto-id
//   Admin-written only. Read allowed to any signed-in user (checkout needs to
//   look up a coupon by code before purchase).
//
// Collection: rewardTransactions    Doc ID: auto-id
//   Normally {userEmail, ...}, self-write only. The signup referral-bonus
//   path additionally writes {userId(=referrer), type:"Referral Bonus",
//   points} with no userEmail — allowed as a narrow, bounded carve-out.
//
// Collection: stockNotifications    Doc ID: auto-id
//   {userEmail, vendorId(=product's vendor uid)}. Create: self (by email).
//   Read/delete: the named vendor or admin.
//
// Collection: productQuestions, productReviews   Doc ID: auto-id
//   Public Q&A/review content on product pages. productQuestions denormalizes
//   vendorId at write time (app/product/[id]/page.tsx), so the owning vendor
//   can answer directly once it's present — admin-only answering is now just
//   the fallback for legacy pre-fix docs missing the field. productReviews
//   has no purchase-verification or one-review-per-user enforcement (a real,
//   known gap, not a rules oversight — flagged separately).
//
// Collection: reviews               Doc ID: auto-id
//   The MOBILE app's own product-review collection — separate from
//   productReviews above, keyed by {productId, orderId, userId(=uid),
//   customerName, customerEmail, rating(1-5), review, photos(array),
//   createdAt}. Unlike productReviews, create requires the caller to
//   actually own the referenced order (ownsReviewOrder()), so a review
//   can't be filed against an order that isn't the caller's. Read:
//   public. No client update/delete — no such UI exists in the app.
//
// Collection: recentlyViewed        Doc ID: auto-id
//   {userId(=uid), productId, name, price, mrp, image, vendorId,
//   vendorName, discountPercent, viewedAt}. Mobile-only, same
//   userId-owned CRUD shape as the cart/wishlist blocks below.
//
// Collection: adminUsers   Doc ID: auto-id
//   Admin-only in every direction. No legitimate client write/read path
//   exists for this outside the admin console today.
//
// Collection: vendor_payouts   Doc ID: auto-id
//   {vendorId(=uid), vendorName, amount, status:"Paid", createdAt}. Admin
//   records a direct settlement here (app/admin/payouts) separately from
//   a seller's own withdrawal request (withdrawals collection below) —
//   both ledgers count toward "already paid" wherever earnings are
//   computed. Write: admin only. Read: admin, or the vendor themselves.
//
// Collection: settings              Doc ID: "global" (singleton)
//   {freeShippingThreshold(number), standardShippingCharge(number),
//   commissionEnabled(bool), commissionRate(number, 0-1, meaningful only
//   when commissionEnabled), upiEnabled(bool), upiVpa(string, YOMICO's own
//   UPI ID — never a real value until an admin sets one, never hardcoded
//   in source), upiPayeeName(string), updatedAt, updatedBy}. Read: public
//   (storefront displays shipping values to signed-out visitors; the UPI
//   VPA is likewise not a secret — it's meant to be given to payers, same
//   as a shop's printed QR). Write: admin only, via app/admin/settings.
//   commissionRate is snapshotted onto each order at checkout
//   (orders.commissionRate) — changing this doc never affects
//   orders already placed; see lib/commission.ts / lib/vendorEarnings.ts.
//
// Collection: rateLimits            Doc ID: "create-order_{uid}"
//   {windowStart(number, ms epoch), count(number)}. Written only via
//   getAdminDb() (app/api/create-order/route.ts) — never by any client, so
//   the default-deny fallback rule at the bottom of this file already
//   covers it and no dedicated match block is needed.
//
// Collection: audit_logs            Doc ID: auto-id
//   {actorUid, actorEmail, action(string), targetId(string), details(map),
//   createdAt}. Written by lib/auditLog.ts after admin KYC/vendor-status/
//   order-status/payout writes succeed, or by a delivery partner
//   confirming a Pay on Delivery (UPI Only) payment (action ==
//   'delivery_payment_confirmed' — the one non-admin action type allowed
//   to self-write here). Append-only: no update or delete for anyone,
//   admin included.
//
// Collection: deliveryPartners      Doc ID: auto-id
//   name, phone, email, uid(string, set once admin provisions a login via
//   a secondary Firebase Auth app instance — see lib/firebase.ts), status
//   ("Active"|"Inactive"). Write: admin only. Read: admin, or the partner
//   themselves (resource.data.uid == request.auth.uid) — needed for their
//   own login lookup and so orders' isAssignedDeliveryPartner() can
//   resolve who is updating a delivery.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // Helper functions
    // ---------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'adminyogimart@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwnerUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isOwnerEmail(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    // users/{uid}.status is written by app/admin/customers/page.tsx's
    // Block/Unblock toggle, but was never read anywhere else -- a blocked
    // customer could still sign in and place orders. Most users never have
    // this field set at all (signup doesn't write it), so .get() with a
    // default is required -- direct dot-access on a genuinely absent field
    // throws and would deny every order for every never-blocked customer.
    //
    // The users/{uid} document itself can also be entirely absent -- not
    // just the status field -- for any account created through a flow that
    // never writes one (e.g. seller/vendor registration, which only ever
    // writes vendors/{uid}). get().data on a nonexistent document throws
    // and denies the whole rule, so exists() must be checked first; a
    // missing document is treated the same as an unblocked account, same
    // as the client-side blocked-check in app/checkout/page.tsx already does.
    function isNotBlocked() {
      return isSignedIn()
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'Active') != 'Blocked'
        );
    }

    function affectedKeysOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function unchanged(field) {
      // A field being deleted entirely (present before, absent after) must
      // count as a change, not "unchanged" — otherwise an update can strip a
      // protected field via FieldValue.delete() to bypass this check.
      return (field in resource.data) == (field in request.resource.data)
        && (!(field in resource.data) || request.resource.data[field] == resource.data[field]);
    }

    function isValidString(field, maxLen) {
      return field in request.resource.data
        && request.resource.data[field] is string
        && request.resource.data[field].size() <= maxLen;
    }

    // ---------------------------------------------------------
    // products
    // ---------------------------------------------------------

    function isValidProduct() {
      let d = request.resource.data;
      return d.vendorId is string
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.sellingPrice is number && d.sellingPrice >= 0
        && d.stock is number && d.stock >= 0;
    }

    // Shared precondition for BOTH directional stock rules below.
    //
    // Individually each of those is bounded — one only allows stock to fall,
    // the other only allows it to rise. But `allow update` is an || chain, so
    // a client may satisfy whichever it prefers, and the union of the two was
    // unbounded in both directions: any signed-in user could set ANY
    // product's stock (and, via the unvalidated `sales` in the checkout rule,
    // its sales count) to any value at all. Neither rule checks ownership,
    // because checkout is legitimately performed by a customer who does not
    // own the product.
    //
    // What every legitimate movement DOES have in common is that units only
    // ever move between the two fields: checkout is -qty/+qty, cancellation
    // is +qty/-qty. So stock + sales is conserved, and requiring that here
    // removes the ability to invent or destroy inventory while leaving both
    // real flows untouched.
    //
    // This is a stopgap, not a complete fix: a caller can still shift a
    // competitor's stock into sales (stock->0), which reads as "Out of
    // Stock". Rules cannot tell whether a decrement corresponds to a real
    // order — only server-authored stock movement can. It does make any
    // tampering visible in `sales` rather than silent.
    function isStockTransfer() {
      return isSignedIn()
        && affectedKeysOnly(['stock', 'sales'])
        && request.resource.data.stock is number
        && request.resource.data.sales is number
        && request.resource.data.stock >= 0
        && request.resource.data.sales >= 0
        && request.resource.data.stock + request.resource.data.sales
           == resource.data.stock + resource.data.sales;
    }

    function isCheckoutStockUpdate() {
      // Any signed-in customer completing checkout may decrement stock /
      // increment sales on a product line item — nothing else may change.
      return isStockTransfer()
        && request.resource.data.stock <= resource.data.stock;
    }

    function isReviewRatingUpdate() {
      // Any signed-in customer submitting a review may update the
      // product's aggregate rating/reviewCount — nothing else may change,
      // reviewCount can only advance by exactly one review at a time, and
      // rating must stay within a valid 0-5 range.
      return isSignedIn()
        && affectedKeysOnly(['rating', 'reviewCount'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
        && request.resource.data.reviewCount is number
        && request.resource.data.reviewCount == resource.data.reviewCount + 1;
    }

    function isViewIncrement() {
      // Any signed-in visitor loading a product page bumps its view
      // count by exactly one — the only thing that made "Trending
      // Products" (sorted by this field) meaningful, since nothing
      // previously incremented it at all.
      return isSignedIn()
        && affectedKeysOnly(['views'])
        && request.resource.data.views is number
        && request.resource.data.views == resource.data.views + 1;
    }

    function isStockRestoreUpdate() {
      // Cancelling an order (by the customer or the seller/admin) restores
      // the stock and reverses the sale count that checkout previously
      // recorded — the exact inverse of isCheckoutStockUpdate, sharing the
      // same conservation precondition so the pair can no longer be combined
      // to reach an arbitrary stock value.
      return isStockTransfer()
        && request.resource.data.stock >= resource.data.stock;
    }

    match /products/{productId} {
      allow read: if true;

      // Server-only: products are created by app/api/seller/create-product,
      // which mints the productNumber (PCT…) from an atomic counter in the
      // same transaction. The Admin SDK bypasses these rules, so denying
      // client create is what guarantees every product gets a number and no
      // browser can invent one. Update/read below are unchanged.
      allow create: if false;

      allow update: if isAdmin()
        || (
          isOwnerUid(resource.data.vendorId)
          && unchanged('vendorId')
          && unchanged('approved')
          && unchanged('featured')
          && unchanged('active')
          && isValidProduct()
        )
        || isCheckoutStockUpdate()
        || isReviewRatingUpdate()
        || isStockRestoreUpdate()
        || isViewIncrement();

      allow delete: if isAdmin() || isOwnerUid(resource.data.vendorId);
    }

    // ---------------------------------------------------------
    // orders
    // ---------------------------------------------------------

    function isValidOrder() {
      let d = request.resource.data;
      return d.userId is string
        && d.vendorIds is list
        && d.items is list
        && d.total is number && d.total >= 0
        && d.status == 'Pending';
    }

    function isLegalOrderStatusTransition(from, to) {
      // No skipping ahead, no moving backward, and no un-cancelling —
      // a seller/admin could previously set any of the 7 values
      // regardless of the order's current status.
      return (from == 'Pending' && to in ['Confirmed', 'Cancelled'])
        || (from == 'Confirmed' && to in ['Packed', 'Cancelled'])
        || (from == 'Packed' && to in ['Shipped', 'Cancelled'])
        || (from == 'Shipped' && to == 'Out For Delivery')
        || (from == 'Out For Delivery' && to in ['Delivered', 'Delivery Failed'])
        || (from == 'Delivery Failed' && to == 'Out For Delivery');
    }

    function isAssignedDeliveryPartner() {
      // deliveryPartnerId stores the deliveryPartners doc id (not a uid) —
      // look up that doc and confirm its uid is the caller's own.
      return isSignedIn()
        && resource.data.deliveryPartnerId is string
        && resource.data.deliveryPartnerId != ''
        && get(/databases/$(database)/documents/deliveryPartners/$(resource.data.deliveryPartnerId)).data.uid == request.auth.uid;
    }

    // Pay on Delivery (UPI Only) payment state machine:
    //   Pending -> AwaitingVerification -> Paid
    // The delivery partner's submission (below) can only ever reach
    // AwaitingVerification, never Paid directly — entering a transaction
    // ID is a claim to be verified, not proof of payment. Only admin can
    // promote AwaitingVerification -> Paid (see app/admin/orders — admin's
    // existing unconditional isAdmin() branch above already covers that
    // write; adding a second, narrower admin-only clause here would be
    // inert, since the broader one already permits every case the
    // narrower one would, so the amount/duplicate-verification guarantees
    // for that step are enforced in application code (lib/deliveryPayment.ts's
    // verifyDeliveryPayment(), which only ever sends the verification
    // fields) plus the audit log, not by further restricting admin here —
    // consistent with every other admin order capability in this file.
    //
    // The submission write itself is deliberately separate from the
    // status-update clause below (never bundled with marking Delivered)
    // so a status change alone can never imply payment was received.
    // One-shot: the order must currently be Pending (rejects resubmission
    // once AwaitingVerification or Paid), a transaction reference is
    // mandatory, and — critically — the delivery partner cannot supply or
    // change any amount at all; paymentAmount was already set server-side
    // at order-creation time and stays outside this write's allowed field
    // set entirely. Nothing outside the submission fields can move —
    // price, total, items, vendorId, commission, paymentAmount, customer
    // info, and deliveryPartnerId are all untouchable from this path.
    function isValidDeliveryPaymentSubmission() {
      return isAssignedDeliveryPartner()
        && resource.data.paymentMethod == 'PAY_ON_DELIVERY_UPI'
        && resource.data.status in ['Out For Delivery', 'Delivered']
        && resource.data.paymentStatus == 'Pending'
        && request.resource.data.paymentStatus == 'AwaitingVerification'
        && request.resource.data.paymentTransactionId is string
        && request.resource.data.paymentTransactionId.size() > 0
        && request.resource.data.paymentConfirmedBy == request.auth.uid
        && request.resource.data.paymentConfirmedByName is string
        && affectedKeysOnly([
          'paymentStatus', 'paymentTransactionId', 'paymentSubmittedAt',
          'paymentConfirmedBy', 'paymentConfirmedByName', 'updatedAt'
        ]);
    }

    // deliveredAt is what YOMICO's 72h delivery clock is measured against, so
    // a client must not be able to choose its value. It may only appear as
    // part of a genuine transition to Delivered, and only as request.time —
    // which serverTimestamp() resolves to and a hand-written Timestamp cannot
    // match. Non-Delivered writes may clear it to null (the delivery-partner
    // screen does this when moving an order back), and any write that leaves
    // it alone is unaffected.
    function isTrustedDeliveredAt() {
      return unchanged('deliveredAt')
        || (
          request.resource.data.status == 'Delivered'
          // Only on the TRANSITION into Delivered. Without this a seller
          // could re-stamp an already-delivered order and walk its recorded
          // completion time forward, which is exactly what the 72h delivery
          // clock is measured against.
          && resource.data.status != 'Delivered'
          && request.resource.data.deliveredAt == request.time
        )
        || (
          request.resource.data.status != 'Delivered'
          && request.resource.data.deliveredAt == null
        );
    }

    match /orders/{orderId} {
      // isAssignedDeliveryPartner() added here as a genuine bug fix, not
      // scope creep: app/delivery/[id]/page.tsx's loadOrder() has always
      // called getDoc() on this exact path, but this rule never granted
      // delivery partners read access at all — discovered via this
      // session's own live rules test, confirmed pre-existing (this read
      // rule was untouched by both Step 1 and Step 2 until now). Without
      // it, the entire delivery-partner order page — not just the new
      // payment section — silently fails to load for a real partner
      // account, so leaving it broken would make Step 2's delivery-partner
      // UI unreachable in production.
      // The vendor branch excludes Pending. An order belongs to the seller
      // only once an admin has confirmed it — before that it may still be
      // cancelled, and the seller has no work to do on it.
      //
      // Enforced here rather than in the UI on purpose. Every seller query
      // against orders must carry where('status','!=','Pending') or the
      // rules engine rejects it outright, so a query that forgets the filter
      // fails loudly instead of leaking. The customer, admin and
      // delivery-partner branches are untouched.
      allow read: if isAdmin()
        || isOwnerUid(resource.data.userId)
        || (
          isSignedIn()
          && request.auth.uid in resource.data.vendorIds
          && resource.data.status != 'Pending'
        )
        || isAssignedDeliveryPartner();

      // Order creation is now SERVER-ONLY, for both payment methods.
      //
      // Pay on Delivery goes through app/api/place-order and Razorpay through
      // app/api/finalize-online-order (or app/api/razorpay/webhook when the
      // browser disappears after capture). All three write with the Admin
      // SDK, which bypasses these rules entirely, so denying client creation
      // costs no legitimate flow — verified: zero addDoc/setDoc against the
      // orders collection remains anywhere in app/.
      //
      // What this closes: isValidOrder() only ever checked that userId,
      // vendorIds, items and total were present and that status was
      // Pending. It never validated finalTotal, prices, discount,
      // rewardValue, shippingCharge, commission or sellerEarning — so a
      // signed-in customer could write an order document with any financial
      // figures they liked, and the vendor-payout calculations downstream
      // would believe them. That is the last client-authored money path in
      // the app.
      //
      // Reads, cancellation, returns and every other branch below are
      // unchanged; only creation moves server-side.
      allow create: if false;

      allow update: if isAdmin()
        || (
          isOwnerUid(resource.data.userId)
          && resource.data.status == 'Pending'
          && request.resource.data.status == 'Cancelled'
          && affectedKeysOnly(['status', 'updatedAt'])
        )
        || (
          isSignedIn()
          && request.auth.uid in resource.data.vendorIds
          // A seller cannot move an order OUT of Pending. Confirmation is an
          // admin action performed by app/api/confirm-order, which is what
          // stamps confirmedAt and starts the 72h delivery clock. Without
          // this line a seller could write Pending -> Confirmed against a
          // known order id despite not being able to read it, producing a
          // Confirmed order with no confirmedAt and therefore no deadline.
          && resource.data.status != 'Pending'
          // Sellers update status together with shipping/tracking
          // details in one save — all of these must be allowed together,
          // not just status, or every save touching tracking info fails.
          // 'status' and 'deliveredAt' are deliberately absent.
          //
          // orders.status is now DERIVED from item fulfilment: the least
          // advanced item across every seller on the order. A seller sets it
          // by advancing their own product through
          // app/api/seller/advance-item, never by writing it. Leaving it
          // writable here would be the bypass — one seller could type
          // "Delivered" onto an order whose other products have not shipped.
          //
          // deliveredAt goes with it: the route stamps it when the LAST item
          // is delivered, which is what the 72h delivery clock measures.
          //
          // Cancellation is unaffected — it runs through /api/cancel-order
          // with the Admin SDK.
          && affectedKeysOnly([
            'updatedAt', 'trackingNumber', 'courierPartner',
            'dispatchDate', 'expectedDelivery', 'sellerNotes', 'paymentStatus'
          ])
          // A seller may only ever move paymentStatus to 'Paid', and only
          // in the same write that marks the order Delivered — this
          // self-mark-paid path is reserved for the legacy cash-COD flow.
          //
          // Now an ALLOW-LIST. It previously read
          // `paymentMethod != 'PAY_ON_DELIVERY_UPI'`, which excluded exactly
          // one value and admitted every other — including 'ONLINE', the
          // bare 'UPI' value some orders carry, and the display string
          // 'Pay on Delivery (UPI Only)'. Production holds four distinct
          // paymentMethod values, so the deny-list left most of them
          // self-certifiable by the vendor, and with earnings now gated on
          // Delivered + Paid that also unlocked their own payout.
          //
          // 'COD' is the only method settled in cash at the door with no
          // second party able to verify it. Pay on Delivery (UPI Only)
          // reaches Paid solely through the delivery partner's
          // transaction-reference write plus admin verification
          // (isValidDeliveryPaymentSubmission below); ONLINE is already
          // Paid at creation. Anything unrecognised is refused by default.
          && (
            unchanged('paymentStatus')
            || (
              request.resource.data.paymentStatus == 'Paid'
              // Reads the order's CURRENT status rather than the incoming
              // one, because a seller can no longer send a status at all.
              // Same guarantee: cash-COD is only self-certifiable once the
              // order has actually been delivered.
              && resource.data.status == 'Delivered'
              && resource.data.paymentMethod == 'COD'
            )
          )
        )
        || (
          // The delivery partner physically handling this order updates
          // status/notes/proof of delivery, but never touches anything
          // financial or ownership-related.
          isAssignedDeliveryPartner()
          && affectedKeysOnly(['status', 'deliveryNotes', 'proofImage', 'deliveredAt', 'updatedAt'])
          && isTrustedDeliveredAt()
          && (
            unchanged('status')
            || isLegalOrderStatusTransition(resource.data.status, request.resource.data.status)
          )
        )
        || isValidDeliveryPaymentSubmission();

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // sellerOrders — one per-seller fulfilment record per (order, vendor).
    //
    // Created ONLY by app/api/confirm-order, inside the confirmation
    // transaction, via the Admin SDK. Client creation is denied outright, so
    // a record cannot come into existence from a customer placing an order —
    // only from an admin confirming one.
    //
    // A record holds exactly one vendor's line items and one vendor's share
    // of the money, so per-seller isolation is a property of the data, not a
    // filter applied at read time. The read rule then makes it a boundary: a
    // seller can only ever address their own records.
    // ---------------------------------------------------------

    // ---- per-ITEM fulfilment ----
    //
    // itemFulfilment is written ONLY by app/api/seller/advance-item, through
    // the Admin SDK, which bypasses these rules. It advances one item and
    // recalculates the parent orders.status in the same transaction, so the
    // summary can never lag the items it summarises.
    //
    // The client-side validators that used to live here are gone with the
    // client write path. The seller update rule below simply omits
    // itemFulfilment from its allow-list, which denies any direct attempt.
    //
    // The forward-only chain itself is enforced by the route, using
    // isLegalItemTransition() in lib/itemFulfilment.ts — a single definition
    // rather than one here and one there that can drift apart.

    match /sellerOrders/{recordId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.vendorId == request.auth.uid);

      // Server-only. The Admin SDK bypasses rules, so the confirmation
      // transaction is unaffected by this.
      allow create, delete: if false;

      // itemFulfilment is off-limits to EVERY client, admins included. An
      // admin browser writing it would advance an item without running the
      // roll-up in app/api/seller/advance-item, leaving orders.status behind
      // the items it summarises. Admins keep every other field.
      allow update: if (isAdmin() && unchanged('itemFulfilment'))
        || (
          isSignedIn()
          && resource.data.vendorId == request.auth.uid
          // Ownership, the parent link, the money, the line items and the
          // timing are all server-owned and immutable from here. items being
          // unchanged is what keeps the itemFulfilment keys meaningful.
          && unchanged('vendorId')
          && unchanged('orderId')
          && unchanged('items')
          && unchanged('vendorSubtotal')
          && unchanged('vendorCommission')
          && unchanged('vendorEarning')
          && unchanged('confirmedAt')
          && unchanged('deliveryDeadlineAt')
          && unchanged('createdAt')
          // No record-level status or deliveredAt: both are DERIVED from the
          // item map on read, so there is nowhere for a summary to drift
          // from the items it summarises.
          // itemFulfilment is NOT in this list. Advancing an item now goes
          // through app/api/seller/advance-item, which moves the item and
          // rolls the parent orders.status up in one transaction. Letting a
          // client write the map directly would let a seller advance a
          // product while leaving the parent summary behind — the roll-up
          // could simply be skipped. The Admin SDK bypasses these rules, so
          // the route is unaffected.
          //
          // What a seller may still write here is their own shipping detail.
          && affectedKeysOnly([
            'courierPartner', 'trackingNumber', 'dispatchDate',
            'expectedDelivery', 'sellerNotes', 'updatedAt'
          ])
        );
    }

    // ---------------------------------------------------------
    // vendors
    // ---------------------------------------------------------

    function isValidVendorApplication() {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.status == 'Pending'
        && d.kycStatus == 'Pending';
    }

    match /vendors/{vendorDocId} {
      allow read: if isAdmin() || isOwnerUid(resource.data.uid);

      allow create: if isSignedIn() && isValidVendorApplication();

      allow update: if isAdmin()
        || (
          isOwnerUid(resource.data.uid)
          && unchanged('uid')
          && unchanged('status')
          && unchanged('kycStatus')
          && unchanged('commissionRate')
          && unchanged('totalSales')
          && unchanged('totalOrders')
          && unchanged('totalRevenue')
          && unchanged('pendingPayout')
          // Tax/GST profile and its verification are written ONLY by
          // app/api/seller/tax-profile (validated) and set VERIFIED only by an
          // admin — never by the seller editing their own vendor doc. sellerNumber
          // is likewise server-minted.
          && unchanged('taxProfile')
          && unchanged('taxVerificationStatus')
          && unchanged('sellerNumber')
        );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // vendors_public — public-safe mirror of vendors, keyed by uid.
    // Storefront pages read this instead of the PII-bearing vendors doc.
    // ---------------------------------------------------------

    function isValidPublicVendorProfile() {
      let d = request.resource.data;
      return d.uid is string
        && d.businessName is string && d.businessName.size() <= 200
        && d.status in ['Pending', 'Approved', 'Rejected', 'Blocked'];
    }

    match /vendors_public/{uid} {
      allow read: if true;

      // Unlike the update branch below, isValidPublicVendorProfile() alone
      // doesn't pin status to 'Pending' here (it also validates the update
      // path, where status is legitimately already 'Approved' etc. and
      // required unchanged) — without this extra check, any signed-in
      // user could self-create their own vendors_public doc as
      // 'Approved' and appear in the storefront directory (app/store)
      // with no vendor-register application or admin review at all.
      allow create: if isAdmin()
        || (
          isOwnerUid(uid)
          && request.resource.data.uid == uid
          && request.resource.data.status == 'Pending'
          && isValidPublicVendorProfile()
        );

      allow update: if isAdmin()
        || (
          isOwnerUid(uid)
          && unchanged('uid')
          && unchanged('status')
          && isValidPublicVendorProfile()
        );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // users
    // ---------------------------------------------------------

    function isValidNewUser() {
      let d = request.resource.data;
      return d.uid == request.auth.uid && d.role == 'customer';
    }

    function isReferralBonusUpdate() {
      // Referral crediting is inherently cross-user: a NEW signup (a
      // different uid) updates the REFERRER's doc — see
      // app/signup/page.tsx's updateDoc(doc(db,'users', referrer.id),
      // {rewardPoints: increment(100), totalReferrals: increment(1)}).
      // Ownership can't be required here, so instead the exact
      // business-rule delta is capped (+100 points, +1 referral per
      // write) — previously any signed-in user could jump ANY other
      // user's rewardPoints straight to an arbitrary higher number in
      // one call, since only ">= previous value" was checked.
      return isSignedIn()
        && affectedKeysOnly(['rewardPoints', 'totalReferrals'])
        && request.resource.data.rewardPoints is number
        && request.resource.data.rewardPoints >= resource.data.rewardPoints
        && request.resource.data.rewardPoints <= resource.data.rewardPoints + 100
        && request.resource.data.totalReferrals is number
        && request.resource.data.totalReferrals >= resource.data.totalReferrals
        && request.resource.data.totalReferrals <= resource.data.totalReferrals + 1;
    }

    function isRewardPointsCheckoutUpdate(userId) {
      // Checkout earns points on a purchase or spends them on a discount —
      // the exact delta can't be validated here without knowing the order,
      // but isolating it to only this field, always a non-negative number,
      // stops it being silently bundled into an unrelated profile write.
      // Unlike the referral bonus above, this is always the signed-in
      // customer's own balance (app/checkout/page.tsx only ever targets
      // doc(db,'users', firebaseUser.uid)), so ownership is required —
      // previously this had no ownership check at all, letting any
      // signed-in user rewrite (or zero out) any OTHER user's balance.
      return isOwnerUid(userId)
        && affectedKeysOnly(['rewardPoints'])
        && request.resource.data.rewardPoints is number
        && request.resource.data.rewardPoints >= 0;
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwnerUid(userId);

      allow create: if isOwnerUid(userId) && isValidNewUser();

      allow update: if isAdmin()
        || (
          isOwnerUid(userId)
          && unchanged('role')
          && unchanged('status')
          && unchanged('uid')
          && unchanged('rewardPoints')
        )
        || isReferralBonusUpdate()
        || isRewardPointsCheckoutUpdate(userId);

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // chats
    // ---------------------------------------------------------

    function isChatParticipant(chatData) {
      return isSignedIn()
        && (
          chatData.sellerId == request.auth.uid
          || ('customerId' in chatData && chatData.customerId == request.auth.uid)
          || ('customerEmail' in chatData && chatData.customerEmail == request.auth.token.email)
        );
    }

    function chatCreatorIsCustomer() {
      let d = request.resource.data;
      // At least one of customerId/customerEmail must be present AND match
      // the caller — a chat can't be created with neither identifier set.
      return d.sellerId is string
        && (
          ('customerId' in d && d.customerId == request.auth.uid)
          || ('customerEmail' in d && d.customerEmail == request.auth.token.email)
        );
    }

    match /chats/{chatId} {
      allow read: if isChatParticipant(resource.data);

      allow create: if isSignedIn() && chatCreatorIsCustomer();

      allow update: if isChatParticipant(resource.data)
        && unchanged('sellerId') && unchanged('customerId') && unchanged('customerEmail')
        && unchanged('productId')
        && affectedKeysOnly([
          'lastMessage', 'lastSender', 'updatedAt', 'lastMessageAt',
          'customerUnread', 'sellerUnread'
        ]);

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // messages (top-level; linked to chats via chatId field)
    // ---------------------------------------------------------

    match /messages/{messageId} {
      allow read: if isChatParticipant(
        get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data
      );

      allow create: if isSignedIn()
        && request.resource.data.chatId is string
        && isChatParticipant(
          get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data
        );

      allow update: if isChatParticipant(
          get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data
        )
        && affectedKeysOnly(['read']);

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // notifications
    // ---------------------------------------------------------

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || ('userId' in resource.data && isOwnerUid(resource.data.userId));

      // Notification creation is legitimately cross-user in this app — a
      // customer's checkout writes to the seller's and admin's feeds, a
      // seller's order update writes to the customer's — so ownership
      // (userId == request.auth.uid) deliberately CANNOT be required here
      // without breaking those flows. Instead the payload itself is pinned
      // down: only known fields, only known roles/types, always unread on
      // creation, and non-empty text. This bounds what a forged write can
      // look like; it does not by itself stop impersonation, which needs
      // creation moved server-side behind the Admin SDK.
      //
      // Field/type lists below are derived from every creation site in the
      // app (checkout, admin orders/delivery/support, seller orders/wallet,
      // delivery, returns, support, vendor-register, lib/returns.ts).
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
             'title', 'message', 'role', 'type', 'read', 'createdAt',
             'userId', 'userEmail'
           ])
        && request.resource.data.keys().hasAll([
             'title', 'message', 'role', 'type', 'read', 'createdAt'
           ])
        && request.resource.data.role in ['customer', 'seller', 'admin']
        && request.resource.data.type in [
             'order', 'delivery', 'shipping', 'refund',
             'support', 'vendor', 'withdrawal'
           ]
        && request.resource.data.read == false
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && (request.resource.data.role == 'admin' || request.resource.data.userId is string)
        // A role:"admin" notification is the only kind with no userId, which
        // is why the admin feed queries on role alone — and why any signed-in
        // customer could previously drop arbitrary text into it. The three
        // non-admin writers that legitimately needed it have moved server-side
        // (app/api/place-order and lib/onlineOrder for orders,
        // app/api/vendor-registered for registrations); the Admin SDK bypasses
        // these rules, so they are unaffected. What remains here is an admin
        // notifying other admins, which app/admin/orders and
        // app/admin/delivery still do from the browser.
        //
        // customer/seller notifications stay cross-user on purpose: a
        // customer's order must reach the seller's feed and a seller's status
        // update must reach the customer's. Those are bounded by the field,
        // type, length and read==false constraints above, and are only
        // readable by the uid they name.
        && (request.resource.data.role != 'admin' || isAdmin());

      allow update: if (
          isAdmin()
          || ('userId' in resource.data && isOwnerUid(resource.data.userId))
        )
        && affectedKeysOnly(['read']);

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // addresses / tickets / returns  (owner = userEmail, except
    // addresses which also accepts the mobile app's userId-owned
    // documents — see isValidMobileAddress() below)
    // ---------------------------------------------------------

    // Mobile app's addresses/{addressId} documents are owned by userId
    // (auth.currentUser.uid), not userEmail like the web app's — this
    // is a separate, additive ownership model, not a replacement for
    // the userEmail one above. Validates the exact fields
    // screens/AddressScreen.tsx's saveAddress() writes.
    function isValidMobileAddress() {
      let d = request.resource.data;
      return 'userId' in d
        && d.userId == request.auth.uid
        && isValidString('name', 100)
        && isValidString('mobile', 15)
        && isValidString('address', 500)
        && isValidString('city', 100)
        && isValidString('state', 100)
        && isValidString('pincode', 10)
        && d.isDefault is bool;
    }

    match /addresses/{addressId} {
      // 'field' in data guards are required here (not optional style),
      // same reason notifications/rewardTransactions' read rules use
      // them above: web-owned docs have no userId field, mobile-owned
      // docs have no userEmail field, and accessing an absent map key
      // directly errors — which would deny the whole || chain instead
      // of falling through to the branch that actually applies.
      allow read, delete: if isAdmin()
        || ('userEmail' in resource.data && isOwnerEmail(resource.data.userEmail))
        || ('userId' in resource.data && isOwnerUid(resource.data.userId));

      // Update is split out from read/delete so the ownership fields can be
      // made immutable.
      //
      // Ownership here is whatever the document itself claims, so an owner
      // who can rewrite userEmail/userId can hand their own document to
      // another account — adding a userEmail to a mobile-owned address, say,
      // which grants that mailbox's owner read/update/delete over it. Nobody
      // gains access to a record they did not already own, so this is
      // nuisance-injection rather than a data leak, but an ownership field
      // the owner can rewrite is not really an ownership field.
      //
      // unchanged() covers both shapes with one guard: it treats
      // absent-in-both as unchanged, so unchanged('userId') passes on a
      // web address that never had one and unchanged('userEmail') passes on
      // a mobile address that never had one. It also counts a field deletion
      // as a change, so the guard cannot be bypassed by stripping the field
      // with FieldValue.delete() and re-adding it.
      //
      // The legitimate write paths are unaffected: app/addresses/page.tsx
      // only ever sends updateDoc({ isDefault }), and the mobile app's
      // default-address toggle does the same.
      //
      // isAdmin() is deliberately NOT subject to the guard.
      allow update: if isAdmin()
        || (
          (
            ('userEmail' in resource.data && isOwnerEmail(resource.data.userEmail))
            || ('userId' in resource.data && isOwnerUid(resource.data.userId))
          )
          && unchanged('userEmail')
          && unchanged('userId')
        );

      allow create: if isSignedIn()
        && (
          ('userEmail' in request.resource.data
            && request.resource.data.userEmail == request.auth.token.email)
          || isValidMobileAddress()
        );
    }

    match /sellerInquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if isValidString('fullName', 200)
        && isValidString('contact', 200)
        && isValidString('message', 2000)
        && request.resource.data.status == 'New';
      allow update: if isAdmin() && affectedKeysOnly(['status', 'adminNote']);
      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      // Mobile app's screens/SupportScreen.tsx writes both userEmail
      // AND userId on create, but loadTickets() queries by userId —
      // a field this rule never checked, so the customer's own
      // ticket-list query was rejected outright. isOwnerUid() is
      // additive here, same ownership model as addresses above;
      // create/update/delete are unchanged. 'field' in data guards
      // are required (see addresses above) since not every ticket
      // is guaranteed to carry both fields.
      allow read: if isAdmin()
        || ('userEmail' in resource.data && isOwnerEmail(resource.data.userEmail))
        || ('userId' in resource.data && isOwnerUid(resource.data.userId));
      allow create: if isSignedIn()
        && request.resource.data.userEmail == request.auth.token.email
        && isValidString('subject', 200)
        && isValidString('message', 2000);

      // Unchanged, and already sufficient for the "customers cannot modify
      // another customer's ticket" requirement: no customer can update or
      // delete ANY ticket, their own included. adminReply/status stay
      // admin-only, which is what keeps a customer from answering their own
      // ticket or reopening a closed one.
      allow update: if isAdmin() && affectedKeysOnly(['status', 'adminReply']);
      allow delete: if isAdmin();
    }

    // ---- P0 #4: refund amount validation ----
    //
    // The refund flow has no API route: app/returns/page.tsx creates the
    // record client-side, an admin types an amount into
    // app/admin/refunds/page.tsx, and lib/returns.ts credits that number
    // verbatim as reward points. Nothing anywhere reads the order, so the
    // amount was unbounded on BOTH sides — a customer could create a record
    // carrying any refundAmount (and any status), and an admin's typed
    // figure had no ceiling at all.

    // orderId arrives straight from a ?orderId= query string and was only
    // ever checked to be a string, so a return could be filed against an
    // order the caller never placed — or one that does not exist. Binding
    // the record to a real order owned by the caller is also what makes the
    // ceiling below meaningful: without it there is no order to cap against.
    function ownsReturnOrder(orderId) {
      return exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
    }

    // Trusted ceiling for an admin-entered refund.
    //
    // finalTotal is the post-coupon, post-reward figure /api/cancel-order
    // already treats as authoritative. Orders predating it may not carry the
    // field, so fall back to total, which isValidOrder() has always required
    // on create. Both use .data.get(field, default) rather than a bare field
    // access: a missing field would otherwise raise and deny, and the final
    // default of 0 means a malformed order caps the refund at zero instead
    // of failing open.
    //
    // Note this is a bound, not a guarantee — finalTotal is still
    // client-authored at checkout today. It becomes fully trustworthy once
    // orders are server-authored (P1).
    function refundCeiling(orderId) {
      let d = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return d.get('finalTotal', d.get('total', 0));
    }

    function isValidRefundAmount(orderId) {
      return request.resource.data.refundAmount is number
        && request.resource.data.refundAmount >= 0
        && request.resource.data.refundAmount <= refundCeiling(orderId);
    }

    match /returns/{returnId} {
      allow read: if isAdmin() || isOwnerEmail(resource.data.userEmail);
      // Return creation is now SERVER-ONLY.
      //
      // app/returns/page.tsx used to addDoc() this document straight from the
      // browser, and the rule below it was the only thing standing between a
      // hand-crafted SDK write and a return record — it pinned refundAmount to
      // 0, status to 'Pending' and verified order ownership. What it could NOT
      // express is everything else that actually governs eligibility:
      //
      //   - the order must be Delivered (a rule cannot read the order's status
      //     without a get() on every write, and there was none)
      //   - the request must be inside the 7-day return window
      //   - only one return may exist per order
      //
      // All three are enforced in app/api/request-return, which re-reads the
      // order and does the duplicate check and the write in one Admin SDK
      // transaction. The Admin SDK bypasses these rules entirely, so denying
      // client creation costs that route nothing — verified: zero addDoc/setDoc
      // against the returns collection remains anywhere in app/.
      //
      // Reads, the admin update branch and admin delete below are unchanged;
      // only creation moves server-side.
      allow create: if false;
      // The cap is only evaluated when the amount actually changes, so every
      // other admin action (status, pickup details, transaction id) still
      // works even if the underlying order was since deleted — only raising
      // the amount requires the order to be readable. orderId must hold
      // still in that same write, otherwise the ceiling would be checked
      // against one order while a different one is stored.
      allow update: if isAdmin()
        && (
          unchanged('refundAmount')
          || (unchanged('orderId') && isValidRefundAmount(resource.data.orderId))
        );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // itemRequests — per-item Return / Replace requests.
    //
    // A NEW collection alongside the legacy order-level `returns` (which is
    // left untouched and keeps working). Every mutation is SERVER-ONLY: the
    // customer creates a request through app/api/item-request, and the admin /
    // seller advance it and run refund crediting / replacement fulfilment
    // through its transition route, all on the Admin SDK — where the refund
    // amount, the item->order->seller binding, per-item eligibility and the
    // state machine can actually be enforced. Because create/update/delete are
    // all denied to clients, no refund amount or status can ever be written
    // from a browser, so there is nothing client-authored to bound here.
    //
    // Reads: the owning customer, the vendor whose item it concerns (a seller
    // therefore sees ONLY their own items — a list must filter by vendorId and
    // an unfiltered query is refused), and admin. One seller can never read
    // another seller's request.
    // ---------------------------------------------------------
    match /itemRequests/{requestId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isSignedIn() && resource.data.vendorId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------
    // counters — atomic sequence sources for human-readable numbers
    // (order/invoice/seller/product/shipment/return/replacement/refund/
    // payment/payout). Written ONLY by server routes via lib/humanIds inside
    // the creating entity's transaction. Fully server-only: the Admin SDK
    // bypasses these rules, and no client may read or move a counter.
    // ---------------------------------------------------------
    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin() || isOwnerEmail(resource.data.vendorEmail);
      // vendorEmail was the ONLY field bound to the caller. vendorId and
      // status were written by app/seller/wallet but never checked here, so
      // a hand-crafted SDK write could set vendorId to ANOTHER vendor's uid
      // and status straight to 'Paid'. app/admin/payouts keys its
      // already-paid tally on vendorId, so such a document silently zeroes
      // the victim's pending payout — and stays invisible to them, because
      // their wallet page lists withdrawals by vendorEmail, which is the
      // attacker's. Pinning both fields closes that off.
      //
      // Withdrawal creation is now SERVER-ONLY, for the reason the previous
      // note here spelled out: these rules could bound WHO the request
      // belonged to and WHAT state it started in, but never HOW MUCH. The
      // real balance is a sum over every delivered-and-paid order minus two
      // payout ledgers, and rules cannot query or sum collections — so the
      // "is this within your balance?" test lived only in the browser, where
      // a seller writing through the SDK simply skipped it.
      //
      // app/api/request-withdrawal now recomputes the payable amount with the
      // Admin SDK (lib/vendorPayable.ts, the same calculation the admin
      // settlement screen performs with its own copy) and refuses anything
      // larger, so the amount
      // that reaches this collection is server-decided. Reads, admin updates
      // and admin deletes below are unchanged.
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // coupons
    // ---------------------------------------------------------

    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    function isCancelledCouponReversal() {
      // Cancelling an order should free up the coupon it used, the same way
      // isStockRestoreUpdate() frees up stock — the redemption may only be
      // deleted by its own owner, and only once the order it's tied to has
      // already legitimately transitioned to Cancelled (itself gated by the
      // orders update rule's own Pending -> Cancelled restriction).
      return isOwnerUid(resource.data.userId)
        && 'orderId' in resource.data
        && resource.data.orderId is string
        && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.status == 'Cancelled';
    }

    match /couponRedemptions/{redemptionId} {
      // Checkout must be able to ask "have I already claimed this coupon?"
      // BEFORE the claim exists (app/checkout/page.tsx's reserveStock reads
      // couponRedemptions/{uid}_{CODE} inside its transaction). For a
      // document that does not exist `resource` is null, so the
      // isOwnerUid(resource.data.userId) clause alone can only ever be
      // satisfied once the claim is already there — which denied every
      // first-time coupon checkout.
      //
      // Claims use a deterministic id (uid + '_' + UPPERCASE code), so
      // ownership is derivable from the PATH, which exists whether or not
      // the document does. A Firebase uid contains no underscore, so the
      // first segment is exactly the owner even when the coupon code
      // contains one. Reading someone else's id is still denied, and this
      // deliberately avoids a blanket `resource == null` allowance, which
      // would let anyone probe {otherUid}_{CODE} and learn from
      // allow-vs-deny whether that customer had redeemed that coupon.
      //
      // The original clause is kept last for redemptions created before the
      // deterministic id existed — those have random ids and can only be
      // authorised by their stored userId.
      allow read: if isAdmin()
        || (isSignedIn() && redemptionId.split('_')[0] == request.auth.uid)
        || isOwnerUid(resource.data.userId);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isValidString('code', 50);
      allow update: if isAdmin();
      allow delete: if isAdmin() || isCancelledCouponReversal();
    }

    // ---------------------------------------------------------
    // rewardTransactions
    // ---------------------------------------------------------

    match /rewardTransactions/{transactionId} {
      allow read: if isAdmin()
        || ('userEmail' in resource.data && isOwnerEmail(resource.data.userEmail));

      allow create: if isAdmin()
        || (
          isSignedIn()
          && 'userEmail' in request.resource.data
          && request.resource.data.userEmail == request.auth.token.email
        )
        || (
          // Signup referral-bonus carve-out: credits another user's uid,
          // bounded and type-locked, no userEmail written.
          isSignedIn()
          && !('userEmail' in request.resource.data)
          && request.resource.data.type == 'Referral Bonus'
          && request.resource.data.points is number
          && request.resource.data.points > 0
          && request.resource.data.points <= 1000
        );

      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // stockNotifications
    // ---------------------------------------------------------

    match /stockNotifications/{notificationId} {
      allow read: if isAdmin()
        || isOwnerUid(resource.data.vendorId)
        || isOwnerEmail(resource.data.userEmail);

      allow create: if isSignedIn()
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.vendorId is string;

      allow delete: if isAdmin() || isOwnerUid(resource.data.vendorId);
      allow update: if isAdmin();
    }

    // ---------------------------------------------------------
    // productQuestions / productReviews  (public Q&A/reviews)
    // ---------------------------------------------------------

    match /productQuestions/{questionId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.productId is string
        && isValidString('question', 1000)
        && request.resource.data.status == 'Pending';
      // vendorId is now written at creation (denormalized from the
      // product), so the owning vendor can answer directly. Older docs
      // created before this fix have no vendorId and fall through to
      // admin-only, same as before.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && 'vendorId' in resource.data
          && resource.data.vendorId == request.auth.uid
          && affectedKeysOnly(['answer', 'status'])
          && request.resource.data.status == 'Answered'
        );
      allow delete: if isAdmin();
    }

    match /productReviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && isValidString('review', 2000);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // reviews  (mobile app's own product-review collection — a
    // separate collection from productReviews above, keyed by
    // orderId+productId+userId, written by
    // screens/OrderDetailsScreen.tsx's submitReview() and read by
    // screens/ProductDetailsScreen.tsx's loadReviews())
    // ---------------------------------------------------------

    // Confirms orderId actually belongs to the caller, the same
    // get()-based ownership pattern returns/{returnId}'s
    // ownsReturnOrder() already uses above — this is what stops a
    // customer from creating a review that claims a rating/photos
    // against an order that isn't theirs, on top of the userId==uid
    // check already covering their own identity.
    function ownsReviewOrder(orderId) {
      return exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
    }

    function isValidMobileReview() {
      let d = request.resource.data;
      return d.userId == request.auth.uid
        && d.productId is string && d.productId.size() > 0
        && d.orderId is string && d.orderId.size() > 0
        && ownsReviewOrder(d.orderId)
        && d.rating is number && d.rating >= 1 && d.rating <= 5
        && isValidString('review', 2000)
        && d.photos is list
        && d.photos.size() <= 10;
    }

    match /reviews/{reviewId} {
      // Public read, matching productReviews above — review content is
      // meant to be shown on the product page regardless of whether
      // the viewer is signed in.
      allow read: if true;

      allow create: if isSignedIn() && isValidMobileReview();

      // No owner-edit/delete path exists in the mobile app today
      // (submitReview() only ever creates); mirrors productReviews'
      // own posture rather than inventing one.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // Admin-only collections (no legitimate client write path exists
    // outside the admin console today)
    // ---------------------------------------------------------

    match /adminUsers/{docId} {
      allow read, write: if isAdmin();
    }

    match /vendor_payouts/{docId} {
      // A vendor needs to see admin-settled payouts against their own
      // account so their wallet balance reflects money already paid this
      // way, not just money paid via their own withdrawal requests.
      allow read: if isAdmin() || isOwnerUid(resource.data.vendorId);
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      // Singleton config doc (settings/global) — freeShippingThreshold /
      // standardShippingCharge. Public read: the storefront (TopStrip,
      // cart) displays these to signed-out visitors too. Admin-only write.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audit_logs/{docId} {
      // Append-only trail of admin money/trust actions (KYC, vendor
      // status, order status override, payouts) plus delivery-partner
      // payment confirmations. No update/delete for anyone, including
      // admin — an editable log isn't an audit trail.
      //
      // The delivery-partner branch is intentionally narrow: it only
      // lets a signed-in caller self-attest their own uid on an entry of
      // exactly this one action type. It is not the enforcement
      // mechanism (the orders write itself is what's strictly gated by
      // isValidDeliveryPaymentSubmission() above) — a forged entry here
      // can't mark any order Paid on its own, so this stays a lightweight
      // supplementary record rather than needing a full re-verification
      // of the delivery-partner/order assignment.
      allow read: if isAdmin();
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.action == 'delivery_payment_confirmed'
        );
      allow update, delete: if false;
    }

    match /deliveryPartners/{docId} {
      // A delivery partner needs to read their own doc to log in (looked
      // up by email, authorized by the returned doc's own uid matching
      // the caller) and so admin/delivery/isAssignedDeliveryPartner()'s
      // get() lookup succeeds when it's the partner themselves reading.
      allow read: if isAdmin() || isOwnerUid(resource.data.uid);
      allow write: if isAdmin();
    }
// ---------------------------------------------------------
    // Mobile app cart
    // ---------------------------------------------------------

    match /cart/{docId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
    // ---------------------------------------------------------
    // Mobile app wishlist
    // ---------------------------------------------------------

    match /wishlist/{docId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
    // ---------------------------------------------------------
    // Mobile app recentlyViewed
    //
    // Browsing history — strictly private, per-user. Same shape as /cart
    // and /wishlist above: uid ownership on every operation, no public
    // read, and deliberately NO admin branch. An admin has no product
    // reason to read an individual customer's browsing history, and the
    // two sibling collections grant none either.
    // ---------------------------------------------------------

    match /recentlyViewed/{docId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // userId pinned on both sides so an update can neither target another
      // customer's document nor reassign ownership of one's own.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
    // ---------------------------------------------------------
    // Everything else: default deny
    // ---------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
