# YOMICO environment variables — NAMES ONLY. Never commit real values.
# Copy to .env.local for local development and fill in what you need.
# Production values live in Vercel → Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Local development target (REQUIRED for `npm run dev`)
# `npm run dev` refuses to start against the PRODUCTION Firebase project.
# Pick ONE of the options below. See README → "Local development".
# ---------------------------------------------------------------------------

# Option A — Firebase Emulator Suite (recommended; nothing real is touched)
#   then run:  npx firebase emulators:start --only firestore,auth,storage --project demo-yomico-local
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-yomico-local
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Option B — a separate DEVELOPMENT Firebase project (all six required)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# FIREBASE_SERVICE_ACCOUNT_KEY=        # that development project's service account JSON, one line

# Option C — deliberately use PRODUCTION from `npm run dev` (avoid; real data)
# NEXT_PUBLIC_ALLOW_PRODUCTION_FIREBASE_IN_DEV=true

# ---------------------------------------------------------------------------
# Server secrets (server-only — never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=
RAZORPAY_KEY_ID=                       # rzp_test_... outside production (enforced)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
CRON_SECRET=
DELIVERY_OTP_SECRET=
GEMINI_API_KEY=
# ALLOW_LIVE_RAZORPAY_IN_DEV=true      # only to deliberately use a live key under `npm run dev`

# ---------------------------------------------------------------------------
# Public (browser) configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY=              # the public key id matching RAZORPAY_KEY_ID
NEXT_PUBLIC_SITE_URL=
